# ============================================================
# AVM SMART SOLUTIONS - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Do NOT commit real secrets or credentials to Git.
# Supply actual values in Render/Vercel Environment Settings.

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/avmsmart?retryWrites=true&w=majority

# Server & Authentication Configuration
PORT=5000
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Initial Admin User Credentials (Seeded on server start if not present in MongoDB)
ADMIN_EMAIL=AVMSmart.admin@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# CORS / Production Frontend Domain Configuration
FRONTEND_URL=https://www.avmsmart.in
NEXT_PUBLIC_API_URL=
